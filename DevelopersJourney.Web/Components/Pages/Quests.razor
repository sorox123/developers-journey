@* link named by what I want to display here (shows in browser as /quests tailer) *@
@page "/quests"

@* allows page to react to typing/clicks *@
@rendermode InteractiveServer

<PageTitle>Quests</PageTitle> @* browser tab text *@

<h1>Quests</h1> @* text on the page *@

@* injects GameState object named Game *@
@inject GameState Game
@* injects SaveService object name storage *@
@inject SaveService Storage
@* injects ApiService object named Api *@
@inject ApiService Api

<input @bind="filter" @bind:event="oninput" /> @* oninput = update on every keystroke *@
<p>Filtering by: @filter</p>

<h3>Add Quest</h3>
<input @bind="newTitle" placeholder="Title" />
<input @bind="newDescription" placeholder="Quest Objectives/Flavortext" />
<select @bind="newDifficulty">
        @foreach (Difficulty level in Enum.GetValues<Difficulty>()) @* for each value (level) in Difficulty enum*@
            {
                <option value="@level">@level</option> @* one drop down item per enum value *@
            }
</select>
<label>
    <input type="checkbox" @bind="newIsMainQuest"/>
    Mark as Main Quest?
</label>
<input type="number" @bind="newXP" />
<input @bind="newTags" placeholder="Tags, comma separated" />
@if (questToEdit == null)
{
    <button @onclick="AddQuestClicked">Add</button> @* note: no () => because method takes no params *@
}
else
{
    //if editing add these buttons instead of the Add button
    <button @onclick="SaveEditClicked">Save</button>
    <button @onclick="CancelEditClicked">Cancel</button>
}
<p>@errorMessage</p>

<ul>
    @foreach (Quest quest in Game.Quests) @* for each Quest object quest in Game's Quest property, list items *@
    {
        @* checks to see if filter contains matching tags with/without matching case, whatever matches "so far", includes quest names themselves *@
        @if (filter == "" || quest.Title.Contains(filter, StringComparison.OrdinalIgnoreCase) || quest.SkillTags.Any(questTag => questTag.Contains(filter, StringComparison.OrdinalIgnoreCase)))
        {
             <li>@quest.Title

            @* loop through SkillTags list *@
            @foreach (string questTag in quest.SkillTags)
            {
                <span>[@questTag]</span> @* each tag in brackets. Pills will come later *@
            }

            @if (quest.IsComplete)
            {
                <span>⭐</span>
            }
            else
            {
                @if (quest != questToEdit)
                {
                    @* when quests are not complete, add button to click complete quests. *@
                    <button @onclick="() => CompleteQuestClicked(quest)">Complete</button> 
                    <button @onclick="() => EditClicked(quest)">Edit</button> 
                }      
            }

            @if (quest != questToEdit)
            {
                @if (quest == questToDelete)
                {
                    <span>Confirm?</span>
                    <button @onclick="() => ConfirmDelete(quest)">Yes</button>
                    <button @onclick="CancelDelete">No</button>
                }
                else
                {
                    <button @onclick="() => DeleteClicked(quest)">Delete</button>   
                }
            }
            </li>
        }
    }
</ul>

<h2>Daily Quests</h2>
@{TimeSpan resetCountDown = Game.TimeUntilReset();} @* This sits outside @code because this runs every time the page draws *@
<p>Resets in: @resetCountDown.Hours h @resetCountDown.Minutes m</p>

<ul>
    @foreach (DailyQuest dailyQuest in Game.DailyQuests)
    {
        <li>
            @dailyQuest.Title
            @dailyQuest.Progress / @dailyQuest.Goal
            @* placeholder progression bar, eventually replace with custom bar where progression text is IN the bar *@
            <progress value="@dailyQuest.Progress" max="@dailyQuest.Goal"> </progress>

            @if (dailyQuest.IsComplete)
            {
                <span>⭐</span>
            }
            else if (dailyQuest != dailyToEdit)
            {
                @if (dailyQuest.Source == ProgressSource.Manual)
                {
                    @* Dailies require clicking the button until complete *@
                    <button @onclick="() => ProgressDailyClicked(dailyQuest)">+1 Progress</button>
                }

                <button @onclick="() => EditDailyClicked(dailyQuest)">Edit</button>
            }

            @if (dailyQuest != dailyToEdit)
            {
                @if (dailyQuest == dailyToDelete)
                {
                    <span>Confirm?</span>
                    <button @onclick="() => ConfirmDeleteDaily(dailyQuest)">Yes</button>
                    <button @onclick="CancelDeleteDaily">No</button>
                }
                else
                {
                    <button @onclick="() => DeleteDailyClicked(dailyQuest)">Delete</button>
                }
            }
        </li>
    }
</ul>

<h3>Add Daily Quest</h3>
<input @bind="newDailyTitle" placeholder="Daily Quest Title" />
<input type="number" @bind="newDailyXP" />
<input type="number" @bind="newDailyGoal"/>
@* disabled = grayed out dropdown =@(...) Blazor fills with bool, true = greyed out fales = disabled is off completely*@
<select @bind="newDailySource" disabled="@(dailyToEdit != null)">
        @foreach (ProgressSource source in Enum.GetValues<ProgressSource>())
            {
                @if(source != ProgressSource.GitHubPushes || Api.IsGitHubLinked())
                {
                    <option value="@source">@source</option>
                }
            }
</select>
@if (dailyToEdit == null)
{
    <button @onclick="AddDailyClicked">Add Daily Quest</button>
}
else
{
    <button @onclick="SaveEditDailyClicked">Save</button>
    <button @onclick="CancelEditDailyClicked">Cancel</button>
}
<p>@dailyErrorMessage</p>

@code {
    //@code converts code within {} to C#
    string filter = ""; //filter starts empty until filled by the user
    string newTitle = ""; //field title for newly added quests
    int newXP = 0; //type="number" @bind converts to int, starts at 0, field for xp in new quest
    string newTags =""; //field for tags for newly added quests
    string newDescription = ""; //field for description the player types
    Difficulty newDifficulty = Difficulty.Beginner; //selection box for selecting difficulty
    bool newIsMainQuest = false;
    string errorMessage = ""; //error to be returned when stopping bad quest creation

    Quest? questToDelete = null; //null until the delete button is pressed for in-progress quests
    Quest? questToEdit = null;

    string newDailyTitle = ""; //field for adding new daily quests
    int newDailyGoal = 0; //field to set the goal for the new daily quests
    int newDailyXP = 0; //field to set the XP reqward for new daily quests
    ProgressSource newDailySource = ProgressSource.Manual; //enum for the source of the new daily. defaults at Manual
    string dailyErrorMessage = ""; //error message for daily quests

    DailyQuest? dailyToDelete = null; //null until the delete button is pressed for the daily quest
    DailyQuest? dailyToEdit = null; //null until the edit button is pressed for the daily quest

    //returns error message string or "" if everything passes
    string ValidateBasics(string title, int xp)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return "Quests must have a title.";
        }
        if (xp <= 0)
        {
            return "Quests should reward XP for your hard work.";
        }
        return ""; //if passes both guards, good to go!
    }

    void CompleteQuestClicked(Quest quest)
    {
        Game.CompleteQuest(quest);
        Storage.SaveGame(Game);
    }

    void ProgressDailyClicked(DailyQuest daily)
    {
        Game.AddDailyProgress(daily);
        Storage.SaveGame(Game);
    }

    void AddDailyClicked()
    {
        dailyErrorMessage = ValidateBasics(newDailyTitle, newDailyXP);
        if (dailyErrorMessage != "")
        {
            return;
        }

        if (newDailyGoal <= 0)
        {
            dailyErrorMessage = "Daily quests should have a goal greater than 0.";
            return;
        }

        DailyQuest newDaily = new DailyQuest
        {
            Title = newDailyTitle,
            Goal = newDailyGoal,
            XP = newDailyXP,
            Source = newDailySource
        };

        Game.AddDaily(newDaily);
        Storage.SaveGame(Game);
        ClearDailyForm();
    }
    void AddQuestClicked()
    {
        if (newIsMainQuest && Game.Quests.Count(q => q.IsMainQuest) >= 3)
        {
            newIsMainQuest = false;
            errorMessage = "You can only have 3 main quests at a time.";
            return;
        }

        errorMessage = ValidateBasics(newTitle, newXP);
        if (errorMessage != "") //if the error message is not empty/if there is an error, return
        {
            return;
        }

        Quest newQuest = new Quest //initializes newQuest with properties taken from fields filled by user
        {
            Title = newTitle,
            XP = newXP,
            //splits tags into array items by , and trims whitespace and removes empty entries. | Allows both StringSplitOptions to happen while .ToList turns it into a list of strings
            SkillTags = newTags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList(),
            Difficulty = newDifficulty,
            Description = newDescription,
            IsMainQuest = newIsMainQuest
        };

        Game.AddQuest(newQuest);
        Storage.SaveGame(Game);
        CancelEditClicked();
    }

    void ClearDailyForm()
    {
        newDailyTitle = "";
        newDailyGoal = 0;
        newDailyXP = 0;
        newDailySource = ProgressSource.Manual;
        dailyErrorMessage = "";
    }

    void DeleteClicked(Quest quest)
    {
        if (quest == questToEdit)
        {
            errorMessage = "Please close the quest editor before deleting.";
            return;
        }

        if (!quest.IsComplete)
        {
            questToDelete = quest;
            return;
        }

        Game.DeleteQuest(quest);
        Storage.SaveGame(Game);
    }

    void DeleteDailyClicked(DailyQuest daily)
    {
        if (!daily.IsComplete)
        {
            dailyToDelete = daily;
            return;
        }

        Game.DeleteDaily(daily);
        Storage.SaveGame(Game);
    }

    void EditClicked(Quest quest)
    {
        //copy quest's title into the form's title field
        newTitle = quest.Title;

        //copy quest cp into the form's xp field
        newXP = quest.XP;

        //copy quest tags into the form's tags field
        newTags = string.Join(", ", quest.SkillTags);

        //copies the quest description into the form's description field
        newDescription = quest.Description;

        //copies the quest difficulty into the form's slect drop box
        newDifficulty = quest.Difficulty;

        //copies the IsMainQuest status from the quest into the form's IsMainQuest checkbox
        newIsMainQuest = quest.IsMainQuest;

        //selects current quest as the one being edited to prevent overwriting other quests by accident
        questToEdit = quest;
    }

    void EditDailyClicked(DailyQuest daily)
    {
        newDailyTitle = daily.Title;
        newDailyGoal = daily.Goal;
        newDailyXP = daily.XP;
        newDailySource = daily.Source;
        dailyToEdit = daily;
    }

    void SaveEditClicked()
    {
        if (questToEdit == null) return; //shouldn't happen but Quest? needs this to ignore the compiler warning

        if (questToEdit.IsComplete)
        {
            CancelEditClicked();
            errorMessage = "Completed quests can't be edited.";
            return;
        }

        if (newIsMainQuest && !questToEdit.IsMainQuest && Game.Quests.Count(q => q.IsMainQuest) >= 3)
        {
            newIsMainQuest = false;
            errorMessage = "You can only have 3 main quests at a time.";
            return;
        }

        errorMessage = ValidateBasics(newTitle, newXP);
        if (errorMessage != "")
        {
            return;
        }

        questToEdit.Title = newTitle;
        questToEdit.XP = newXP;
        questToEdit.SkillTags = newTags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        questToEdit.Description = newDescription;
        questToEdit.Difficulty = newDifficulty;
        questToEdit.IsMainQuest = newIsMainQuest;

        Storage.SaveGame(Game);

        CancelEditClicked();
    }

    void SaveEditDailyClicked()
    {
        if (dailyToEdit == null) return; //shouldn't happen but DailyQuest? needs this to ignore the compiler warning

        if(dailyToEdit.IsComplete)
        {
            CancelEditDailyClicked();
            dailyErrorMessage = "Completed daily quests can't be edited.";
            return;
        }

        dailyErrorMessage = ValidateBasics(newDailyTitle, newDailyXP);
        if (dailyErrorMessage != "")
        {
            return;
        }

        if (newDailyGoal <= 0) //checks to see if the new goal is greater than 0
        {
            dailyErrorMessage = "Daily quests must have a goal greater than 0.";
            return;
        }

        if (newDailyGoal < dailyToEdit.Progress) //checks to make sure the new set goal isn't already met/exceeded
        {
            dailyErrorMessage = "Daily quest goal cannot be less than today's progress.";
            return;
        }

        dailyToEdit.Title = newDailyTitle;
        dailyToEdit.XP = newDailyXP;
        dailyToEdit.Goal = newDailyGoal;
        Storage.SaveGame(Game);
        CancelEditDailyClicked();
    }

    void CancelEditClicked() //clear fields and stop editing
    {
        newTitle = "";
        newXP = 0;
        newTags = "";
        newDescription = "";
        newDifficulty = Difficulty.Beginner;
        newIsMainQuest = false;
        errorMessage = "";

        //stop editing
        questToEdit = null;
    }

    void CancelEditDailyClicked()
    {
        ClearDailyForm();
        dailyToEdit = null;
    }

    void ConfirmDelete(Quest quest)
    {
        Game.DeleteQuest(quest);
        questToDelete = null;
        Storage.SaveGame(Game);
    }

    void ConfirmDeleteDaily(DailyQuest daily)
    {
        Game.DeleteDaily(daily);
        dailyToDelete = null;
        Storage.SaveGame(Game);
    }

    void CancelDeleteDaily()
    {
        dailyToDelete = null;
    }

    void CancelDelete()
    {
        questToDelete = null;
    }


}