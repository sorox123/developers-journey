@* link named by what I want to display here (shows in browser as /quests tailer) *@
@page "/quests"

@* allows page to react to typing/clicks *@
@rendermode InteractiveServer

<PageTitle>Quests</PageTitle> @* browser tab text *@

<h1>Quests</h1> @* text on the page *@

@* injects GameState object named Game *@
@inject GameState Game
@* injects SaveService object name storage *@
@inject SaveService Storage

<input @bind="filter" @bind:event="oninput" /> @* oninput = update on every keystroke *@
<p>Filtering by: @filter</p>

<h3>Add Quest</h3>
<input @bind="newTitle" placeholder="Title" />
<input type="number" @bind="newXP" />
<input @bind="newTags" placeholder="Tags, comma separated" />
@if (questToEdit == null)
{
    <button @onclick="AddQuestClicked">Add</button> @* note: no () => because method takes no params *@
}
else
{
    //if editing add these buttons instead of the Add button
    <button @onclick="SaveEditClicked">Save</button>
    <button @onclick="CancelEditClicked">Cancel</button>
}
<p>@errorMessage</p>

<ul>
    @foreach (Quest quest in Game.Quests) @* for each Quest object quest in Game's Quest property, list items *@
    {
        @* checks to see if filter contains matching tags with/without matching case, whatever matches "so far", includes quest names themselves *@
        @if (filter == "" || quest.Title.Contains(filter, StringComparison.OrdinalIgnoreCase) || quest.SkillTags.Any(questTag => questTag.Contains(filter, StringComparison.OrdinalIgnoreCase)))
        {
             <li>@quest.Title

            @* loop through SkillTags list *@
            @foreach (string questTag in quest.SkillTags)
            {
                <span>[@questTag]</span> @* each tag in brackets. Pills will come later *@
            }

            @if (quest.IsComplete)
            {
                <span>⭐</span>
            }
            else
            {
                @if (quest != questToEdit)
                {
                    @* when quests are not complete, add button to click complete quests. *@
                    <button @onclick="() => CompleteQuestClicked(quest)">Complete</button> 
                }

                <button @onclick="() => EditClicked(quest)">Edit</button>       
            }

            @if (quest == questToDelete)
            {
                <span>Confirm?</span>
                <button @onclick="() => ConfirmDelete(quest)">Yes</button>
                <button @onclick="CancelDelete">No</button>
            }
            else
            {
                <button @onclick="() => DeleteClicked(quest)">Delete</button>
            }

            </li>
        }
    }
</ul>

<h2>Daily Quests</h2>
@{TimeSpan resetCountDown = Game.TimeUntilReset();} @* This sits outside @code because this runs every time the page draws *@
<p>Resets in: @resetCountDown.Hours h @resetCountDown.Minutes m</p>


<ul>
    @foreach (DailyQuest dailyQuest in Game.DailyQuests)
    {
        <li>
            @dailyQuest.Title
            @dailyQuest.Progress / @dailyQuest.Goal
            @* placeholder progression bar, eventually replace with custom bar where progression text is IN the bar *@
            <progress value="@dailyQuest.Progress" max="@dailyQuest.Goal"> </progress>

            @if (dailyQuest.IsComplete)
            {
                <span>⭐</span>
            }
            else if (dailyQuest.Source == ProgressSource.Manual)
            {
                @* Dailies require clicking the button until complete *@
                <button @onclick="() => ProgressDailyClicked(dailyQuest)">+1 Progress</button>
            }
        </li>
    }
</ul>

@code {
    //@code converts code within {} to C#
    string filter = ""; //filter starts empty until filled by the user
    string newTitle = ""; //field title for newly added quests
    int newXP = 0; //type="number" @bind converts to int, starts at 0, field for xp in new quest
    string newTags =""; //field for tags for newly added quests
    string errorMessage = ""; //error to be returned when stopping bad quest creation

    Quest? questToDelete = null; //null until the delete button is pressed for in-progress quests
    Quest? questToEdit = null;


    void CompleteQuestClicked(Quest quest)
    {
        Game.CompleteQuest(quest);
        Storage.SaveGame(Game);
    }

    void ProgressDailyClicked(DailyQuest daily)
    {
        Game.AddDailyProgress(daily);
        Storage.SaveGame(Game);
    }

    void AddQuestClicked()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) //IsNullOrWhiteSpace checks for whitespace or null strings
        {
            errorMessage = "Quests must have a title!";
            return;
        }

        if (newXP <= 0)
        {
            errorMessage = "Quests should reward your hard work with XP.";
            return;
        }

        errorMessage = "";

        Quest newQuest = new Quest //initializes newQuest with properties taken from fields filled by user
        {
            Title = newTitle,
            XP = newXP,
            //splits tags into array items by , and trims whitespace and removes empty entries. | Allows both StringSplitOptions to happen while .ToList turns it into a list of strings
            SkillTags = newTags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList() 
        };

        Game.AddQuest(newQuest);
        Storage.SaveGame(Game);
        newTitle = "";
        newXP = 0;
        newTags = "";
    }

    void DeleteClicked(Quest quest)
    {
        if (!quest.IsComplete)
        {
            questToDelete = quest;
            return;
        }

        Game.DeleteQuest(quest);
        Storage.SaveGame(Game);
    }

    void EditClicked(Quest quest)
    {
        //copy quest's title into the form's title variable;
        newTitle = quest.Title;

        newXP = quest.XP;

        newTags = string.Join(", ", quest.SkillTags);

        questToEdit = quest;
    }

    void SaveEditClicked()
    {
        if (questToEdit == null) return; //shouldn't happen but Quest? needs this to ignore the compiler warning

        if (questToEdit.IsComplete)
        {
            CancelEditClicked();
            errorMessage = "Completed quests can't be edited.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newTitle)) //IsNullOrWhiteSpace checks for whitespace or null strings
        {
            errorMessage = "Quests must have a title!";
            return;
        }

        if (newXP <= 0)
        {
            errorMessage = "Quests should reward your hard work with XP.";
            return;
        }

        errorMessage = "";

        questToEdit.Title = newTitle;
        questToEdit.XP = newXP;
        questToEdit.SkillTags = newTags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();

        Storage.SaveGame(Game);

        CancelEditClicked();
    }

    void CancelEditClicked() //clear fields and stop editing
    {
        newTitle = "";
        newXP = 0;
        newTags = "";
        errorMessage = "";

        //stop editing
        questToEdit = null;
    }

    void ConfirmDelete(Quest quest)
    {
        Game.DeleteQuest(quest);
        questToDelete = null;
        Storage.SaveGame(Game);
    }

    void CancelDelete()
    {
        questToDelete = null;
    }
}